---
interface Props {
  initialCourse?: string;
}

const { initialCourse = '' } = Astro.props;
---

<div id="contact-form-container" class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 shadow-xs">
  <!-- Success Message State (Hidden initially) -->
  <div id="contact-success" class="hidden py-8 text-center space-y-4">
    <div class="w-14 h-14 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-full mx-auto flex items-center justify-center text-2xl font-bold">
      ✓
    </div>
    <h3 class="text-2xl font-bold text-brand-900 font-serif">Enquiry Successfully Sent</h3>
    <p class="text-slate-600 max-w-md mx-auto text-sm leading-relaxed" id="contact-success-desc">
      Thank you for reaching out to Infinity International Skills Development Ltd. An educational advisor will review your enquiry and contact you within 24 business hours.
    </p>
    <div class="pt-2">
      <button
        type="button"
        id="contact-reset-btn"
        class="btn-secondary !text-xs !py-2 !px-4"
      >
        Send Another Enquiry
      </button>
    </div>
  </div>

  <!-- Form -->
  <form id="contact-form" class="space-y-5">
    <!-- Honeypot spam trap -->
    <div class="hidden" aria-hidden="true">
      <label for="botCheck">Leave blank</label>
      <input type="text" id="botCheck" name="botCheck" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="fullName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Full Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="fullName"
          name="fullName"
          required
          placeholder="e.g. Tanvir Ahmed"
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100 transition-all"
        />
      </div>

      <div>
        <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Email Address <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="name@example.com"
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100 transition-all"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Phone / WhatsApp <span class="text-slate-400 text-[11px] font-normal">(Optional)</span>
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="+880 1712 345678"
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100 transition-all"
        />
      </div>

      <div>
        <label for="enquiryType" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Enquiry Type <span class="text-red-500">*</span>
        </label>
        <select
          id="enquiryType"
          name="enquiryType"
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 text-sm focus:outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100 transition-all"
        >
          <option value="Course Information">Course Information</option>
          <option value="Admissions & Enrolment">Admissions &amp; Enrolment</option>
          <option value="Educational Support">Educational Support</option>
          <option value="General Enquiry">General Enquiry</option>
        </select>
      </div>
    </div>

    <div>
      <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
        Message <span class="text-red-500">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        required
        rows="4"
        placeholder="Please describe your educational goals, the qualifications you are interested in, or any questions you have..."
        class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:border-brand-700 focus:ring-2 focus:ring-brand-100 transition-all resize-y"
      ></textarea>
    </div>

    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="privacyConsent"
        name="privacyConsent"
        required
        class="mt-1 h-4 w-4 rounded border-slate-300 text-brand-800 focus:ring-brand-700"
      />
      <label for="privacyConsent" class="text-xs text-slate-600 leading-snug">
        I consent to Infinity International Skills Development Ltd processing my details to reply to my enquiry in accordance with UK data protection legislation. <span class="text-red-500">*</span>
      </label>
    </div>

    <div id="contact-error" class="hidden p-3.5 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-xs">
      <!-- Error text -->
    </div>

    <div class="pt-2">
      <button
        type="submit"
        id="contact-submit-btn"
        class="btn-primary w-full sm:w-auto !py-3 !px-8"
      >
        <span id="contact-btn-text">Send Enquiry</span>
      </button>
    </div>

    <p class="text-[11px] text-slate-500">
      Submissions are securely routed to <span class="font-medium text-slate-700">info@infinityskillsdev.com</span>
    </p>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBox = document.getElementById('contact-success');
  const errorBox = document.getElementById('contact-error');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('contact-btn-text');
  const resetBtn = document.getElementById('contact-reset-btn');
  const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;

  // Check URL parameters for pre-selected course
  const params = new URLSearchParams(window.location.search);
  const courseParam = params.get('course');
  if (courseParam && messageInput) {
    messageInput.value = `Hello, I would like to enquire about: ${courseParam}`;
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const botCheck = (document.getElementById('botCheck') as HTMLInputElement)?.value;
      if (botCheck) return;

      const fullName = (document.getElementById('fullName') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
      const phone = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
      const enquiryType = (document.getElementById('enquiryType') as HTMLSelectElement)?.value;
      const message = messageInput?.value.trim() || '';
      const privacyConsent = (document.getElementById('privacyConsent') as HTMLInputElement)?.checked;

      if (!fullName || !email || !message || !privacyConsent) {
        if (errorBox) {
          errorBox.textContent = 'Please fill in all required fields and accept the privacy consent.';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      if (errorBox) errorBox.classList.add('hidden');
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = 'Submitting Enquiry...';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fullName, email, phone, enquiryType, message, privacyConsent }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          form.classList.add('hidden');
          if (successBox) successBox.classList.remove('hidden');
        } else {
          if (errorBox) {
            errorBox.textContent = data.message || 'Submission failed. Please email us directly at info@infinityskillsdev.com.';
            errorBox.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (errorBox) {
          errorBox.textContent = 'A network error occurred. Please try again or email us directly at info@infinityskillsdev.com.';
          errorBox.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Send Enquiry';
      }
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (form) {
        form.reset();
        form.classList.remove('hidden');
      }
      if (successBox) successBox.classList.add('hidden');
    });
  }
</script>

