---
import Logo from './Logo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about' },
  { label: 'Courses', href: '/courses' },
  { label: 'Our Partner', href: '/partner' },
  { label: 'Contact Us', href: '/contact' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
  <!-- Utility bar with direct WhatsApp and Phone access -->
  <div class="hidden md:block border-b border-slate-100 bg-brand-50/80">
    <div class="container-site flex items-center justify-between h-9 text-[13px] text-slate-600">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="text-slate-700 font-medium">UK Registered · London E7 0QH</span>
      </div>
      <div class="flex items-center gap-5">
        <a
          href="https://wa.me/442045692266?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20UK%20qualifications."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-emerald-700 font-semibold hover:text-emerald-800"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.075-2.227-.557-1.745-.722-2.883-2.502-2.97-2.618-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.453.748.971 1.209.669.595 1.233.78 1.408.867.174.087.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.158.572 4.184 1.574 5.938l-1.574 5.754 5.922-1.553c1.706.942 3.666 1.477 5.753 1.477 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z" />
          </svg>
          <span>WhatsApp Chat</span>
        </a>
        <span class="h-3 w-px bg-slate-300"></span>
        <a href="tel:+442045692266" class="hover:text-brand-800 font-medium">+44 20 4569 2266</a>
        <span class="h-3 w-px bg-slate-300"></span>
        <a href="mailto:info@infinityskillsdev.com" class="hover:text-brand-800">info@infinityskillsdev.com</a>
      </div>
    </div>
  </div>

  <div class="container-site flex items-center justify-between h-[76px]">
    <a href="/" aria-label="Infinity International Skills Development – Home">
      <Logo />
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Main">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`text-[15px] transition-colors py-1 border-b-2 font-medium ${
            isActive(link.href)
              ? 'text-brand-900 border-amber-500'
              : 'text-slate-600 border-transparent hover:text-brand-900'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="https://wa.me/442045692266?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20UK%20qualifications."
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition-colors"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.075-2.227-.557-1.745-.722-2.883-2.502-2.97-2.618-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.453.748.971 1.209.669.595 1.233.78 1.408.867.174.087.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.158.572 4.184 1.574 5.938l-1.574 5.754 5.922-1.553c1.706.942 3.666 1.477 5.753 1.477 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z" />
        </svg>
        <span>WhatsApp</span>
      </a>
      <a href="/contact" class="btn-primary !py-2 !px-3.5 sm:!px-4 text-xs font-semibold whitespace-nowrap">Enquire Now</a>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden p-2 -mr-2 text-slate-700"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white max-h-[calc(100vh-76px)] overflow-y-auto">
    <nav class="container-site py-4 flex flex-col">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`py-3 text-base border-b border-slate-100 ${
            isActive(link.href) ? 'text-brand-900 font-semibold' : 'text-slate-700'
          }`}
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4 flex flex-col gap-2.5">
        <a
          href="https://wa.me/442045692266?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20UK%20qualifications."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp text-center"
        >
          Chat on WhatsApp (+44 20 4569 2266)
        </a>
        <a href="/contact" class="btn-primary text-center">Enquire Now</a>
      </div>
      <div class="mt-5 text-sm text-slate-600 space-y-1">
        <div>38 Woodgrange Road, London, England, E7 0QH</div>
        <div>Phone: <a href="tel:+442045692266" class="text-brand-800 font-medium">+44 20 4569 2266</a></div>
        <div>Email: <a href="mailto:info@infinityskillsdev.com" class="text-brand-800 font-medium">info@infinityskillsdev.com</a></div>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
