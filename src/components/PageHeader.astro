---
interface Props {
  title: string;
  intro?: string;
  breadcrumb?: string;
}

const { title, intro, breadcrumb } = Astro.props;
---

<section class="bg-brand-50 border-b border-slate-200">
  <div class="container-site py-10 sm:py-14 md:py-20">
    {breadcrumb && (
      <nav class="text-sm text-slate-500 mb-4 sm:mb-5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-800">Home</a>
        <span class="mx-2 text-slate-400">/</span>
        <span class="text-slate-700">{breadcrumb}</span>
      </nav>
    )}
    <h1 class="text-3xl sm:text-4xl md:text-5xl leading-tight max-w-3xl">{title}</h1>
    {intro && <p class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">{intro}</p>}
  </div>
</section>

