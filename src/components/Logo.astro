---
interface Props {
  isDarkTheme?: boolean;
  class?: string;
}

const { isDarkTheme = false, class: className = '' } = Astro.props;
const logoSrc = isDarkTheme ? '/logo-white.png' : '/logo.png';
---

<img
  src={logoSrc}
  alt="Infinity International Skills Development"
  width="586"
  height="315"
  class={`${isDarkTheme ? 'h-16 sm:h-20' : 'h-12 sm:h-14'} w-auto object-contain select-none ${className}`}
/>
