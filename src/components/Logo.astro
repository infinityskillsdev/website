---
interface Props {
  isDarkTheme?: boolean;
  class?: string;
}

const { isDarkTheme = false, class: className = '' } = Astro.props;
const markBg = isDarkTheme ? '#ffffff' : '#1b2b4b';
const markFg = isDarkTheme ? '#1b2b4b' : '#ffffff';
---

<span class={`inline-flex items-center gap-3 ${className}`}>
  <!-- Simple monogram mark: shield with an infinity line -->
  <svg viewBox="0 0 40 44" class="w-9 h-10 flex-shrink-0" aria-hidden="true">
    <path d="M20 1.5 L38 7.5 V22 C38 33 20 42.5 20 42.5 C20 42.5 2 33 2 22 V7.5 Z" fill={markBg} />
    <path
      d="M13.5 26 C10.5 26 8.5 24 8.5 21.5 C8.5 19 10.5 17 13.5 17 C17 17 18.5 20 20 21.5 C21.5 23 23 26 26.5 26 C29.5 26 31.5 24 31.5 21.5 C31.5 19 29.5 17 26.5 17 C23 17 21.5 20 20 21.5 C18.5 23 17 26 13.5 26 Z"
      fill="none"
      stroke={markFg}
      stroke-width="2.2"
      stroke-linejoin="round"
    />
    <rect x="17" y="9" width="6" height="2" rx="1" fill="#b8893b" />
  </svg>
  <span class="flex flex-col leading-none">
    <span
      class={`font-serif text-[19px] font-semibold tracking-wide ${isDarkTheme ? 'text-white' : 'text-brand-900'}`}
    >
      Infinity International
    </span>
    <span class={`text-[11px] tracking-[0.14em] uppercase mt-1.5 ${isDarkTheme ? 'text-slate-400' : 'text-slate-500'}`}>
      Skills Development
    </span>
  </span>
</span>
