---
interface Props {
  isDarkTheme?: boolean;
  class?: string;
}

const { isDarkTheme = false, class: className = '' } = Astro.props;
const logoSrc = isDarkTheme ? '/logo-white.png' : '/logo.png';
---

<img
  src={logoSrc}
  alt="Infinity International Skills Development"
  width="1018"
  height="189"
  class={`h-8 sm:h-11 w-auto object-contain select-none ${className}`}
/>
