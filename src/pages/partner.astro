---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { courses } from '../data/courses';
---

<Layout
  path="/partner"
  title="Our Partner – Gatehouse Awards"
  description="Infinity International Skills Development Ltd works in partnership with Gatehouse Awards, a UK awarding organisation recognised by Ofqual."
>
  <PageHeader
    breadcrumb="Our Partner"
    title="Our partner – Gatehouse Awards"
    intro="Gatehouse Awards (GA) is a UK awarding organisation recognised by Ofqual, the qualifications regulator in England."
  />

  <section class="py-14 sm:py-20 lg:py-24">
    <div class="container-site grid lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-7 prose-body">
        <h2 class="text-3xl mb-6">About Gatehouse Awards</h2>
        <p>
          Gatehouse Awards is a UK awarding organisation recognised by Ofqual, the Office of Qualifications and
          Examinations Regulation. It offers a range of academic, vocational and professional qualifications across
          different subject areas, supporting education providers and learners in the UK and internationally.
        </p>

        <h2 class="text-3xl mt-12 sm:mt-14 mb-6">About our partnership</h2>
        <p>
          Infinity International Skills Development Ltd works in partnership with Gatehouse Awards to promote a selected
          range of qualifications in business, management, innovation, entrepreneurship and international foundation
          studies.
        </p>
        <p>
          Through this partnership, we aim to help prospective learners access clear, reliable information about
          qualifications that support further education, professional development and career progression.
        </p>

        <h2 class="text-3xl mt-12 sm:mt-14 mb-6">Why these qualifications</h2>
        <ul class="space-y-4 text-[17px] text-slate-600 leading-relaxed">
          <li class="pl-5 border-l-2 border-amber-500">
            <strong class="text-slate-900 font-medium">Regulated standards.</strong> Awarded by an Ofqual-recognised organisation.
          </li>
          <li class="pl-5 border-l-2 border-amber-500">
            <strong class="text-slate-900 font-medium">Clear progression.</strong> Defined levels and credit values that support further study.
          </li>
          <li class="pl-5 border-l-2 border-amber-500">
            <strong class="text-slate-900 font-medium">Practical relevance.</strong> Content focused on modern business, management and enterprise.
          </li>
        </ul>
      </div>

      <aside class="lg:col-span-5">
        <div class="lg:sticky lg:top-32 border border-slate-200 rounded-lg p-6 sm:p-8">
          <h3 class="text-xl">Qualifications we promote</h3>
          <p class="mt-2 text-sm text-slate-500">{courses.length} Gatehouse Awards qualifications, Levels 2–5</p>
          <ul class="mt-6 space-y-3 text-[15px]">
            {courses.map((c) => (
              <li>
                <a href={`/courses#${c.id}`} class="text-slate-700 hover:text-brand-800 hover:underline underline-offset-4">
                  {c.title.replace('GA ', '')}
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-8 pt-6 border-t border-slate-200 flex flex-col gap-3">
            <a href="/courses" class="btn-primary">View course details</a>
            <a href="https://gatehouseawards.org/" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              Visit gatehouseawards.org ↗
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="container-site">
    <div class="bg-brand-50 border border-slate-200 rounded-lg p-6 sm:p-8 text-sm text-slate-600 leading-relaxed">
      <strong class="text-slate-900 font-medium">Please note:</strong> qualifications are developed and awarded by
      Gatehouse Awards. Infinity International Skills Development Ltd promotes selected qualifications and provides
      educational guidance and learner support.
    </div>
  </section>
</Layout>
