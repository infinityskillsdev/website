---
import AdminLayout from '../../layouts/AdminLayout.astro';
import BlogManager from '../../components/admin/BlogManager';
---

<AdminLayout title="Blog Management" activeTab="blog">
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Blog Content Manager</h1>
    <p class="text-sm text-slate-400 mt-1">
      Author, edit, and publish rich Markdown articles with embedded on-page SEO meta tags and live SERP previews.
    </p>
  </div>

  <!-- React Interactive Blog Manager Island -->
  <BlogManager client:load />
</AdminLayout>

