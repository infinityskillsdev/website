---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SeoPanel from '../../components/admin/SeoPanel';
---

<AdminLayout title="SEO Engine Dashboard" activeTab="seo">
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Search Engine Optimization Engine</h1>
    <p class="text-sm text-slate-400 mt-1">
      Manage page titles, descriptions, social OpenGraph banners, structured JSON-LD data, and URL redirects in real-time.
    </p>
  </div>

  <!-- React Interactive Panel Island -->
  <SeoPanel client:load />
</AdminLayout>
