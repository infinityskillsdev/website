---
import Layout from '../../layouts/Layout.astro';
import { db, ensureDbInitialized } from '../../db/client';
import { posts } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

await ensureDbInitialized();

const publishedPosts = await db
  .select()
  .from(posts)
  .where(eq(posts.status, 'published'))
  .orderBy(desc(posts.publishedAt));

const categories = Array.from(new Set(publishedPosts.map((p) => p.category)));

function getReadingTime(content: string): string {
  const words = content.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.ceil(words / 200));
  return `${minutes} min read`;
}
---

<Layout
  path="/blog"
  title="Educational Insights & Guidance"
  description="Explore articles and guides on UK qualifications, business skills, university admissions, and career development."
  noindex={true}
>
  <!-- Notice indicating this page is currently hidden from public navigation -->
  <div class="bg-amber-50 border-b border-amber-200 py-2.5 px-4 text-center text-xs text-amber-900">
    <strong>Administrative Notice:</strong> This blog hub is prepared for future digital marketing and is currently unlisted from public navigation and search engines.
  </div>

  <section class="bg-slate-50 border-b border-slate-200 py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block text-xs font-bold uppercase tracking-wider text-blue-950 border-b-2 border-blue-950 pb-1 mb-4">
        Educational Knowledge Base
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight font-serif">
        Educational Insights & Guidance
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Articles, qualification advice, and practical guides to empower your professional development.
      </p>
    </div>
  </section>

  <section class="container-site py-12 sm:py-16 bg-white">
    <!-- Category Filters -->
    {categories.length > 0 && (
      <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
        <span class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-blue-950 text-white cursor-pointer">
          All Articles ({publishedPosts.length})
        </span>
        {categories.map((cat) => (
          <span class="px-3.5 py-1.5 rounded-lg text-xs font-medium bg-slate-100 text-slate-700 hover:bg-slate-200 cursor-pointer transition-colors">
            {cat}
          </span>
        ))}
      </div>
    )}

    <!-- Articles Grid -->
    {publishedPosts.length === 0 ? (
      <div class="p-16 text-center text-slate-600 rounded-2xl bg-slate-50 border border-slate-200 max-w-xl mx-auto space-y-3">
        <h3 class="text-xl font-bold text-slate-900 font-serif">Articles in Preparation</h3>
        <p class="text-sm text-slate-600 leading-relaxed">
          The blog section has been structured and templated for future digital marketing and SEO publishing. When ready, posts can be published via the Admin Blog Manager.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {publishedPosts.map((post) => (
          <article class="flex flex-col bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-slate-400 transition-colors">
            {post.coverImage && (
              <div class="aspect-video w-full overflow-hidden bg-slate-100">
                <img
                  src={post.coverImage}
                  alt={post.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
                  <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-950 font-semibold text-[11px] uppercase tracking-wider">
                    {post.category}
                  </span>
                  <span>{getReadingTime(post.content)}</span>
                </div>
                <h2 class="text-lg font-bold text-slate-900 mb-2 leading-snug font-serif hover:text-blue-950">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h2>
                <p class="text-slate-600 text-xs line-clamp-3 mb-4 leading-relaxed">
                  {post.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                <span>{post.author}</span>
                <span class="text-blue-950 font-semibold">Read article →</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>
