---
import Layout from '../../layouts/Layout.astro';
import { db, ensureDbInitialized } from '../../db/client';
import { posts } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

await ensureDbInitialized();

const publishedPosts = await db
  .select()
  .from(posts)
  .where(eq(posts.status, 'published'))
  .orderBy(desc(posts.publishedAt));

// Extract unique categories
const categories = Array.from(new Set(publishedPosts.map((p) => p.category)));

function getReadingTime(content: string): string {
  const words = content.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.ceil(words / 200));
  return `${minutes} min read`;
}
---

<Layout path="/blog" title="Latest Insights, Engineering & SEO Trends" description="Read our latest technical insights on high-speed web architecture, Core Web Vitals, and search engine optimization.">
  <section class="max-w-6xl mx-auto px-4 py-20">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 mb-4">
        <span>📖 Engineering & SEO Journal</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        Insights, Guides & Performance
      </h1>
      <p class="text-lg text-slate-400">
        Actionable articles on building superfast websites, mastering technical SEO, and modern fullstack architectures.
      </p>
    </div>

    <!-- Category Filters -->
    {categories.length > 0 && (
      <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-indigo-600 text-white shadow-sm cursor-pointer">
          All Articles ({publishedPosts.length})
        </span>
        {categories.map((cat) => (
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-slate-900 border border-slate-800 text-slate-400 hover:text-white cursor-pointer transition-colors">
            {cat}
          </span>
        ))}
      </div>
    )}

    <!-- Articles Grid -->
    {publishedPosts.length === 0 ? (
      <div class="p-12 text-center text-slate-500 rounded-2xl bg-slate-900/40 border border-slate-800">
        No published articles yet. Visit the <a href="/admin/blog" class="text-indigo-400 underline">Admin Blog Manager</a> to write your first post!
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {publishedPosts.map((post) => (
          <article class="flex flex-col rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-slate-700 overflow-hidden transition-all group hover:-translate-y-1">
            <a href={`/blog/${post.slug}`} class="aspect-video w-full overflow-hidden bg-slate-800 relative">
              <img
                src={post.coverImage || 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=1200&h=630&fit=crop'}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class="absolute top-3 right-3 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-950/80 backdrop-blur text-indigo-300 border border-indigo-500/20">
                {post.category}
              </span>
            </a>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
                  <span>{new Date(post.publishedAt || Date.now()).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                  <span>•</span>
                  <span>{getReadingTime(post.content)}</span>
                </div>

                <h2 class="text-xl font-bold text-white group-hover:text-indigo-400 transition-colors line-clamp-2 mb-3">
                  <a href={`/blog/${post.slug}`}>
                    {post.title}
                  </a>
                </h2>

                <p class="text-slate-400 text-sm line-clamp-3 leading-relaxed mb-6">
                  {post.excerpt}
                </p>
              </div>

              <div class="flex items-center justify-between pt-4 border-t border-slate-800/80 text-xs">
                <span class="font-medium text-slate-300">By {post.author}</span>
                <a href={`/blog/${post.slug}`} class="font-bold text-indigo-400 group-hover:text-indigo-300 flex items-center gap-1">
                  Read Article →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>

