---
import Layout from '../../layouts/Layout.astro';
import { db, ensureDbInitialized } from '../../db/client';
import { posts } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { marked } from 'marked';

await ensureDbInitialized();

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const [post] = await db.select().from(posts).where(eq(posts.slug, slug)).limit(1);

if (!post || (post.status === 'draft' && !Astro.cookies.get('infinity_admin_token')?.value)) {
  return new Response(null, { status: 404, statusText: 'Article Not Found' });
}

const renderedHtml = marked.parse(post.content || '') as string;

const readingTimeMinutes = Math.max(1, Math.ceil((post.content || '').trim().split(/\s+/).length / 200));
const formattedDate = new Date(post.publishedAt || Date.now()).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Layout
  path={`/blog/${post.slug}`}
  title={post.metaTitle || post.title}
  description={post.metaDescription || post.excerpt}
>
  <article class="max-w-4xl mx-auto px-4 py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-8">
      <a href="/" class="hover:text-slate-300">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-slate-300">Blog</a>
      <span>/</span>
      <span class="text-slate-400 truncate max-w-xs">{post.title}</span>
    </nav>

    <!-- Post Header -->
    <header class="mb-10">
      <div class="flex items-center gap-3 text-xs font-semibold mb-4">
        <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          {post.category}
        </span>
        <span class="text-slate-500">•</span>
        <time datetime={new Date(post.publishedAt || Date.now()).toISOString()} class="text-slate-400">
          {formattedDate}
        </time>
        <span class="text-slate-500">•</span>
        <span class="text-slate-400">{readingTimeMinutes} min read</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
        {post.title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-400 leading-relaxed">
        {post.excerpt}
      </p>

      <div class="flex items-center gap-4 mt-8 pt-6 border-t border-slate-800">
        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm">
          {post.author ? post.author.slice(0, 2).toUpperCase() : 'IN'}
        </div>
        <div>
          <div class="text-sm font-bold text-white">{post.author}</div>
          <div class="text-xs text-slate-500">Author & Contributor</div>
        </div>
      </div>
    </header>

    <!-- Cover Image -->
    {post.coverImage && (
      <div class="rounded-2xl overflow-hidden mb-12 border border-slate-800 shadow-2xl">
        <img
          src={post.coverImage}
          alt={post.title}
          class="w-full max-h-[500px] object-cover"
        />
      </div>
    )}

    <!-- Markdown Content Area -->
    <div
      class="prose prose-invert max-w-none text-slate-300 leading-relaxed text-base space-y-6 [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:text-white [&>h2]:mt-10 [&>h2]:mb-4 [&>h3]:text-xl [&>h3]:font-bold [&>h3]:text-white [&>h3]:mt-8 [&>h3]:mb-3 [&>p]:leading-relaxed [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:space-y-2 [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:space-y-2 [&>blockquote]:border-l-4 [&>blockquote]:border-indigo-500 [&>blockquote]:pl-4 [&>blockquote]:italic [&>blockquote]:text-slate-400 [&>code]:bg-slate-900 [&>code]:px-1.5 [&>code]:py-0.5 [&>code]:rounded [&>code]:text-indigo-300 [&>code]:text-sm"
      set:html={renderedHtml}
    />

    <!-- Post Footer -->
    <footer class="mt-16 pt-8 border-t border-slate-800 flex items-center justify-between">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-bold text-indigo-400 hover:text-indigo-300 transition-colors"
      >
        ← Back to all articles
      </a>

      <div class="flex items-center gap-3">
        <a
          href="/admin/blog"
          class="text-xs text-slate-500 hover:text-slate-300 underline"
        >
          Manage articles
        </a>
      </div>
    </footer>
  </article>
</Layout>

