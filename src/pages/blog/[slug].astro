---
import Layout from '../../layouts/Layout.astro';
import { db, ensureDbInitialized } from '../../db/client';
import { posts } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { marked } from 'marked';

await ensureDbInitialized();

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const [post] = await db.select().from(posts).where(eq(posts.slug, slug)).limit(1);

if (!post || (post.status === 'draft' && !Astro.cookies.get('infinity_admin_token')?.value)) {
  return new Response(null, { status: 404, statusText: 'Article Not Found' });
}

const renderedHtml = marked.parse(post.content || '') as string;

const readingTimeMinutes = Math.max(1, Math.ceil((post.content || '').trim().split(/\s+/).length / 200));
const formattedDate = new Date(post.publishedAt || Date.now()).toLocaleDateString('en-GB', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Layout
  path={`/blog/${post.slug}`}
  title={post.metaTitle || post.title}
  description={post.metaDescription || post.excerpt}
  noindex={true}
>
  <article class="max-w-4xl mx-auto px-4 py-16 bg-white">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-8">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-slate-900">Blog</a>
      <span>/</span>
      <span class="text-slate-700 truncate max-w-xs">{post.title}</span>
    </nav>

    <!-- Post Header -->
    <header class="mb-10 border-b border-slate-200 pb-8">
      <div class="flex items-center gap-3 text-xs font-semibold mb-4 text-slate-500">
        <span class="px-2.5 py-1 rounded bg-blue-50 text-blue-950 font-bold uppercase tracking-wider text-[11px]">
          {post.category}
        </span>
        <span>•</span>
        <time datetime={new Date(post.publishedAt || Date.now()).toISOString()}>
          {formattedDate}
        </time>
        <span>•</span>
        <span>{readingTimeMinutes} min read</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight font-serif leading-tight mb-6">
        {post.title}
      </h1>

      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-sm">
          {post.author.charAt(0)}
        </div>
        <div>
          <div class="text-sm font-semibold text-slate-900">{post.author}</div>
          <div class="text-xs text-slate-500">Educational Advisor</div>
        </div>
      </div>
    </header>

    <!-- Cover Image -->
    {post.coverImage && (
      <div class="aspect-video w-full rounded-2xl overflow-hidden bg-slate-100 mb-12 border border-slate-200">
        <img src={post.coverImage} alt={post.title} class="w-full h-full object-cover" />
      </div>
    )}

    <!-- Content Area -->
    <div
      class="prose prose-slate max-w-none text-slate-700 text-base leading-relaxed space-y-6"
      set:html={renderedHtml}
    />
  </article>
</Layout>
