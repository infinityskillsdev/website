---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  path="/contact"
  title="Contact Us"
  description="Contact Infinity International Skills Development Ltd in London about courses, admissions guidance or educational support."
>
  <PageHeader
    breadcrumb="Contact Us"
    title="Get in touch"
    intro="Have questions about our courses, educational support or admissions guidance? Contact our team and we will be happy to assist you."
  />

  <section class="py-16 lg:py-20 bg-white">
    <div class="container-site grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="text-2xl md:text-3xl text-brand-900">Send us an enquiry</h2>
        <p class="mt-2 text-slate-600 text-sm">Fill in the form below and our London team will respond promptly.</p>
        <div class="mt-8">
          <ContactForm />
        </div>
      </div>

      <aside class="lg:col-span-5 space-y-8">
        <!-- Prominent WhatsApp card for instant replies -->
        <div class="p-6 rounded-xl bg-emerald-50 border border-emerald-200 space-y-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Fastest Response</span>
          </div>
          <h3 class="text-lg font-bold text-emerald-950 font-serif">Instant WhatsApp Assistance</h3>
          <p class="text-xs text-emerald-900 leading-relaxed">
            Preferred by international learners. Message our educational advisors directly on WhatsApp for quick answers regarding fees, entry rules, and enrolment.
          </p>
          <a
            href="https://wa.me/447515474714?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20UK%20qualifications%20and%20admissions."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp w-full text-center"
          >
            <span>Message +44 7515 474714</span>
          </a>
        </div>

        <div>
          <h3 class="text-xl font-bold text-brand-900 font-serif mb-4">Official Contact Details</h3>
          <dl class="space-y-4 text-sm">
            <div class="p-4 rounded-lg bg-slate-50 border border-slate-200">
              <dt class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Registered Address</dt>
              <dd class="text-slate-900 font-medium leading-relaxed">
                Infinity International Skills Development Ltd<br />
                38 Woodgrange Road<br />
                London, England, E7 0QH
              </dd>
            </div>
            <div class="p-4 rounded-lg bg-slate-50 border border-slate-200">
              <dt class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Direct Phone</dt>
              <dd><a href="tel:+447515474714" class="text-brand-800 font-bold hover:underline">+44 7515 474714</a></dd>
            </div>
            <div class="p-4 rounded-lg bg-slate-50 border border-slate-200">
              <dt class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Electronic Mail</dt>
              <dd><a href="mailto:info@infinityskillsdev.com" class="text-brand-800 font-bold hover:underline">info@infinityskillsdev.com</a></dd>
            </div>
          </dl>
        </div>

        <div class="rounded-xl overflow-hidden border border-slate-200 shadow-xs">
          <div class="p-3 bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-700">
            London Headquarters Map (E7 0QH)
          </div>
          <iframe
            title="Map showing 38 Woodgrange Road, London E7 0QH"
            src="https://maps.google.com/maps?q=38+Woodgrange+Road,+London+E7+0QH&z=15&output=embed"
            class="w-full h-64 block"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </aside>
    </div>
  </section>
</Layout>
