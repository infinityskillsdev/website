---
import Layout from '../layouts/Layout.astro';
import { courses } from '../data/courses';

const featured = courses.filter((c) => c.highlight).slice(0, 4);

const services = [
  {
    number: '01',
    title: 'Personalised Learning Guidance',
    text: 'One-to-one advice tailored to your previous education and career goals, helping you choose the right qualification route with confidence.',
    badge: 'Guidance',
    cardBg: 'bg-[#FDF2EE]',
    cardBorder: 'border-[#EBC6B8] hover:border-[#B5532E]',
    topRule: 'border-t-[#B5532E]',
    iconBg: 'bg-[#B5532E] text-white',
    badgeStyle: 'bg-[#F9E1D8] text-[#7D3216]',
    linkColor: 'text-[#963E1D] hover:text-[#6B2A11]',
    icon: 'compass',
  },
  {
    number: '02',
    title: 'Tutoring Support',
    text: 'Access to experienced subject tutors who help strengthen your knowledge, prepare for assessments, and build successful study habits.',
    badge: 'Tutoring',
    cardBg: 'bg-[#EDF5F7]',
    cardBorder: 'border-[#C2DCE3] hover:border-[#144D5E]',
    topRule: 'border-t-[#144D5E]',
    iconBg: 'bg-[#144D5E] text-white',
    badgeStyle: 'bg-[#D7E9EE] text-[#0E3946]',
    linkColor: 'text-[#144D5E] hover:text-[#0B2D38]',
    icon: 'tutoring',
  },
  {
    number: '03',
    title: 'Skills Development',
    text: 'Practical opportunities to develop commercial, administrative and entrepreneurial capabilities that prepare you for the workplace.',
    badge: 'Skills',
    cardBg: 'bg-[#EFF6F2]',
    cardBorder: 'border-[#C1DDD1] hover:border-[#174E3B]',
    topRule: 'border-t-[#174E3B]',
    iconBg: 'bg-[#174E3B] text-white',
    badgeStyle: 'bg-[#D6EAE0] text-[#113B2C]',
    linkColor: 'text-[#174E3B] hover:text-[#0E3326]',
    icon: 'skills',
  },
  {
    number: '04',
    title: 'University Admissions Guidance',
    text: 'Structured support in understanding UK higher education pathways, entry requirements, UCAS applications, and foundation routes.',
    badge: 'Admissions',
    cardBg: 'bg-[#FAF0F2]',
    cardBorder: 'border-[#E5C4CC] hover:border-[#742233]',
    topRule: 'border-t-[#742233]',
    iconBg: 'bg-[#742233] text-white',
    badgeStyle: 'bg-[#F2DCE1] text-[#591826]',
    linkColor: 'text-[#742233] hover:text-[#4F1521]',
    icon: 'admissions',
  },
];

const pathwaySteps = [
  {
    step: '01',
    level: 'Level 2 & 3 Foundations',
    title: 'Foundation & Entry Pathways',
    description: 'Establish core business, IT, and administrative skills. Perfect for learners preparing for higher education or entering employment.',
    target: 'Age 16+ · High School graduates',
    cardBg: 'bg-[#FDF7EC]',
    borderColor: 'border-[#E8D5B5] hover:border-[#C48329]',
    topBar: 'bg-[#C48329]',
    badgeColor: 'bg-[#F4E4C3] text-[#6E450D]',
    stepBadge: 'bg-[#C48329] text-white',
    footerBg: 'bg-[#F6EAD3] border-t border-[#E8D5B5] text-[#5E3A09]',
    exploreLink: 'text-[#8C5810] hover:text-[#5E3A09]',
  },
  {
    step: '02',
    level: 'Level 4 & 5 Diplomas',
    title: 'Advanced Business & Management',
    description: 'Equivalent in academic rigor to the first two years of a UK undergraduate degree, covering leadership, strategy, and operations.',
    target: 'Undergraduate level study',
    cardBg: 'bg-[#EFF6F8]',
    borderColor: 'border-[#C2DCE3] hover:border-[#144D5E]',
    topBar: 'bg-[#144D5E]',
    badgeColor: 'bg-[#D7E9EE] text-[#0E3946]',
    stepBadge: 'bg-[#144D5E] text-white',
    footerBg: 'bg-[#DFEEF2] border-t border-[#C2DCE3] text-[#0E3946]',
    exploreLink: 'text-[#144D5E] hover:text-[#092832]',
  },
  {
    step: '03',
    level: 'Progression & Career',
    title: 'Degree Top-Up & Career Advancement',
    description: 'Use your recognised credits towards university progression, Bachelor top-up degrees, or managerial positions in the international marketplace.',
    target: 'University & Professional roles',
    cardBg: 'bg-[#EFF6F2]',
    borderColor: 'border-[#C1DDD1] hover:border-[#174E3B]',
    topBar: 'bg-[#174E3B]',
    badgeColor: 'bg-[#D6EAE0] text-[#113B2C]',
    stepBadge: 'bg-[#174E3B] text-white',
    footerBg: 'bg-[#DCECE4] border-t border-[#C1DDD1] text-[#113B2C]',
    exploreLink: 'text-[#174E3B] hover:text-[#0B2B20]',
  },
];

function getCourseTheme(level: string, category: string) {
  if (category === 'International Foundation') {
    return {
      cardBg: 'bg-[#F0F7F3]',
      border: 'border-[#C3DFD0] border-l-4 border-l-[#174E3B] hover:border-[#174E3B]',
      badgeBg: 'bg-[#174E3B] text-white',
      creditsBg: 'bg-[#DCEEE4] text-[#113B2C]',
      dotColor: 'bg-[#174E3B]',
      tagText: 'text-[#113B2C]',
      titleHover: 'hover:text-[#174E3B]',
    };
  }
  if (level.includes('Level 5')) {
    return {
      cardBg: 'bg-[#FAF1F3]',
      border: 'border-[#E5C4CC] border-l-4 border-l-[#742233] hover:border-[#742233]',
      badgeBg: 'bg-[#742233] text-white',
      creditsBg: 'bg-[#F2DCE1] text-[#591826]',
      dotColor: 'bg-[#742233]',
      tagText: 'text-[#591826]',
      titleHover: 'hover:text-[#742233]',
    };
  }
  if (level.includes('Level 4')) {
    return {
      cardBg: 'bg-[#F0F6F8]',
      border: 'border-[#C5DCE3] border-l-4 border-l-[#144D5E] hover:border-[#144D5E]',
      badgeBg: 'bg-[#144D5E] text-white',
      creditsBg: 'bg-[#DCEBF0] text-[#0E3946]',
      dotColor: 'bg-[#144D5E]',
      tagText: 'text-[#0E3946]',
      titleHover: 'hover:text-[#144D5E]',
    };
  }
  if (level.includes('Level 3')) {
    return {
      cardBg: 'bg-[#FDF8EE]',
      border: 'border-[#E8D7B9] border-l-4 border-l-[#C48329] hover:border-[#C48329]',
      badgeBg: 'bg-[#C48329] text-white',
      creditsBg: 'bg-[#F4E6CA] text-[#6E450D]',
      dotColor: 'bg-[#C48329]',
      tagText: 'text-[#6E450D]',
      titleHover: 'hover:text-[#9E6518]',
    };
  }
  return {
    cardBg: 'bg-[#F5F4F0]',
    border: 'border-slate-300 border-l-4 border-l-[#102347] hover:border-[#102347]',
    badgeBg: 'bg-[#102347] text-white',
    creditsBg: 'bg-slate-200 text-[#102347]',
    dotColor: 'bg-[#102347]',
    tagText: 'text-[#102347]',
    titleHover: 'hover:text-[#102347]',
  };
}
---

<Layout
  path="/"
  title="Empowering Learners. Inspiring Futures."
  description="Infinity International Skills Development Ltd supports learners through personalised educational guidance, skills development and access to recognised Gatehouse Awards qualifications."
>
  <!-- Hero Section -->
  <section class="border-b border-[#E5DFD3] bg-[#FAF8F4]">
    <div class="container-site grid lg:grid-cols-12 gap-12 lg:gap-14 items-center py-16 lg:py-22">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-md text-xs font-semibold bg-[#EFE9DD] border border-[#DDD3C1] text-[#102347] mb-6">
          <span class="w-2 h-2 rounded-xs bg-[#B8893B]"></span>
          <span class="tracking-wide uppercase">Educational Support &amp; Regulated UK Qualifications</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl leading-[1.1] text-[#102347] font-serif">
          Empowering Learners. <br />
          <span class="text-[#B5532E] italic font-serif">Inspiring Futures.</span>
        </h1>

        <p class="mt-6 text-lg text-slate-700 leading-relaxed max-w-xl">
          At <strong class="text-[#102347] font-semibold">Infinity International Skills Development Ltd</strong>, we believe quality education should be accessible to everyone. We support learners through personalised guidance, skills development and access to information about recognised UK professional qualifications.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap gap-3.5 items-center">
          <a
            href="/courses"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg text-sm font-semibold bg-[#102347] hover:bg-[#0A1833] text-white transition-colors"
          >
            <span>Explore Courses</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="https://wa.me/447515474714?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20UK%20qualifications%20and%20admissions."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg text-sm font-semibold bg-[#174E3B] hover:bg-[#113B2C] text-white transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.075-2.227-.557-1.745-.722-2.883-2.502-2.97-2.618-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.453.748.971 1.209.669.595 1.233.78 1.408.867.174.087.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.158.572 4.184 1.574 5.938l-1.574 5.754 5.922-1.553c1.706.942 3.666 1.477 5.753 1.477 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z" />
            </svg>
            <span>WhatsApp Chat</span>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg text-sm font-semibold border border-[#C9C0B0] text-[#102347] bg-white hover:border-[#102347] transition-colors"
          >
            <span>Make an Enquiry</span>
          </a>
        </div>
      </div>

      <!-- Hero Visual Image with Offset Solid Frame -->
      <div class="lg:col-span-5 relative">
        <div class="hidden sm:block absolute inset-0 translate-x-3 translate-y-3 rounded-xl bg-[#B8893B]/25 border border-[#B8893B]/40" aria-hidden="true"></div>
        <div class="relative rounded-xl overflow-hidden border border-[#DDD3C1] bg-white shadow-md">
          <img
            src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=1000&q=75&auto=format&fit=crop"
            alt="Students collaborating on coursework"
            class="w-full aspect-[4/3] object-cover"
            width="1000"
            height="750"
            fetchpriority="high"
          />
        </div>

        <!-- Crisp Navy Accreditation Card -->
        <div class="hidden sm:flex absolute -bottom-5 -left-5 bg-[#102347] text-white rounded-lg px-4 py-3.5 shadow-lg items-center gap-3 border border-[#233B6B]">
          <div class="w-9 h-9 rounded-md bg-[#B8893B] text-[#102347] flex items-center justify-center font-bold text-base shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div class="text-xs leading-snug">
            <span class="block font-bold text-white text-sm">Ofqual Regulated</span>
            <span class="text-[#E6C98F]">Gatehouse Awards Qualifications</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credibility & Fast Facts Strip: 4 Bold Color-Blocked Tiles -->
  <section class="border-b border-[#E5DFD3] bg-[#F2EDE3] py-8">
    <div class="container-site grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="flex items-center gap-4 bg-[#102347] text-white p-5 rounded-xl shadow-xs">
        <div class="w-11 h-11 rounded-lg bg-white/10 text-[#E6B86A] flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-5.825-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          </svg>
        </div>
        <div>
          <div class="font-bold text-base leading-snug">11 Qualifications</div>
          <div class="text-xs text-slate-300 mt-0.5">Levels 2 to 5 Diplomas</div>
        </div>
      </div>

      <div class="flex items-center gap-4 bg-[#174E3B] text-white p-5 rounded-xl shadow-xs">
        <div class="w-11 h-11 rounded-lg bg-white/10 text-[#A7DFC5] flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <div class="font-bold text-base leading-snug">Gatehouse Awards</div>
          <div class="text-xs text-[#CBE9DA] mt-0.5">UK Ofqual-Regulated Body</div>
        </div>
      </div>

      <div class="flex items-center gap-4 bg-[#742233] text-white p-5 rounded-xl shadow-xs">
        <div class="w-11 h-11 rounded-lg bg-white/10 text-[#F3C6CF] flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <div>
          <div class="font-bold text-base leading-snug">London Headquarters</div>
          <div class="text-xs text-[#F5D6DC] mt-0.5">38 Woodgrange Rd, E7 0QH</div>
        </div>
      </div>

      <div class="flex items-center gap-4 bg-[#144D5E] text-white p-5 rounded-xl shadow-xs">
        <div class="w-11 h-11 rounded-lg bg-white/10 text-[#A8DFEE] flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <div>
          <div class="font-bold text-base leading-snug">WhatsApp Support</div>
          <div class="text-xs text-[#C7E9F3] mt-0.5">+44 7515 474714</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Progression Pathway -->
  <section class="py-20 lg:py-24 bg-white border-b border-[#E5DFD3]">
    <div class="container-site">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#963E1D] bg-[#FDF2EE] border border-[#EBC6B8] px-3.5 py-1 rounded-md mb-3">
          Your Educational Journey
        </span>
        <h2 class="text-3xl md:text-4xl text-[#102347] font-serif">
          Progression Pathway to UK Higher Education &amp; Careers
        </h2>
        <p class="mt-4 text-slate-600 text-base sm:text-lg">
          Our qualifications provide recognized credit-bearing milestones, allowing learners to advance step-by-step from foundational learning into advanced diplomas and university degrees.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
        {pathwaySteps.map((s) => (
          <div class={`rounded-xl border ${s.borderColor} ${s.cardBg} flex flex-col justify-between overflow-hidden transition-colors`}>
            <div class={`h-2 w-full ${s.topBar}`}></div>

            <div class="p-7 sm:p-8">
              <div class="flex items-center justify-between gap-2 mb-5">
                <span class={`text-xs font-bold px-2.5 py-1 rounded-md ${s.badgeColor}`}>
                  {s.level}
                </span>
                <span class={`w-9 h-9 rounded-lg ${s.stepBadge} flex items-center justify-center font-serif font-bold text-sm`}>
                  {s.step}
                </span>
              </div>
              <h3 class="text-xl font-bold text-[#102347] mb-3">{s.title}</h3>
              <p class="text-sm text-slate-700 leading-relaxed">{s.description}</p>
            </div>

            <div class={`px-7 sm:px-8 py-4 ${s.footerBg} flex items-center justify-between text-xs`}>
              <span class="font-semibold">{s.target}</span>
              <a href="/courses" class={`font-bold ${s.exploreLink} underline-offset-4 hover:underline inline-flex items-center gap-1`}>
                <span>Explore</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <p class="text-sm text-slate-600 max-w-2xl mx-auto">
          Need personalized advice on which stage aligns with your current qualifications or HSC / A-Level results?
        </p>
        <div class="mt-5 flex justify-center flex-wrap gap-3">
          <a
            href="https://wa.me/447515474714?text=Hello%2C%20I%20am%20from%20Bangladesh%20and%20would%20like%20guidance%20on%20UK%20course%20progression."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-xs font-semibold bg-[#174E3B] hover:bg-[#113B2C] text-white transition-colors"
          >
            Ask an Advisor on WhatsApp
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-xs font-semibold bg-white border border-[#C9C0B0] text-[#102347] hover:border-[#102347] transition-colors"
          >
            Book an Advisory Call
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational Services -->
  <section class="py-20 lg:py-24 bg-[#FAF8F4] border-b border-[#E5DFD3]">
    <div class="container-site">
      <div class="max-w-2xl">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#144D5E] bg-[#EDF5F7] border border-[#C2DCE3] px-3.5 py-1 rounded-md mb-3">
          Support Services
        </span>
        <h2 class="text-3xl md:text-4xl text-[#102347] font-serif">Our Educational Services</h2>
        <p class="mt-3 text-lg text-slate-600">Dedicated guidance at every stage of your learning journey.</p>
      </div>

      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((s) => (
          <div class={`rounded-xl border border-t-4 ${s.cardBorder} ${s.topRule} ${s.cardBg} p-6 flex flex-col justify-between transition-colors`}>
            <div>
              <div class="flex items-center justify-between mb-5">
                <span class={`text-[11px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider ${s.badgeStyle}`}>
                  {s.badge}
                </span>
                <span class="text-sm font-serif font-bold text-slate-400">{s.number}</span>
              </div>

              <div class={`w-11 h-11 rounded-lg ${s.iconBg} flex items-center justify-center mb-4`}>
                {s.icon === 'compass' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.85">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a10 10 0 100 20 10 10 0 000-20zm3.5 6.5l-2 5.5-5.5 2 2-5.5 5.5-2z" />
                  </svg>
                )}
                {s.icon === 'tutoring' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.85">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-5.825-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5" />
                  </svg>
                )}
                {s.icon === 'skills' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.85">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                )}
                {s.icon === 'admissions' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.85">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
              </div>

