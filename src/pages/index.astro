---
import Layout from '../layouts/Layout.astro';
import { courses } from '../data/courses';

const featured = courses.filter((c) => c.highlight).slice(0, 4);

const services = [
  {
    number: '01',
    title: 'Personalised Learning Guidance',
    text: 'One-to-one advice tailored to your previous education and career goals, helping you choose the right qualification route with confidence.',
    badge: 'Guidance',
    badgeStyle: 'bg-amber-200/90 text-amber-950 border-amber-400 font-bold',
    accentGradient: 'from-amber-400 via-amber-500 to-orange-500',
    iconBg: 'bg-gradient-to-br from-amber-500 to-orange-500 text-white shadow-amber-500/30',
    cardBorderHover: 'hover:border-amber-500 hover:shadow-amber-500/20',
    cardBg: 'bg-gradient-to-br from-amber-100/70 via-orange-50/60 to-amber-50 border-2 border-amber-300',
    footerBorder: 'border-amber-200/90',
    footerLink: 'text-amber-800 hover:text-amber-950',
    icon: 'compass',
  },
  {
    number: '02',
    title: 'Tutoring Support',
    text: 'Access to experienced subject tutors who help strengthen your knowledge, prepare for assessments, and build successful study habits.',
    badge: 'Tutoring',
    badgeStyle: 'bg-blue-200/90 text-blue-950 border-blue-400 font-bold',
    accentGradient: 'from-blue-500 via-indigo-500 to-blue-600',
    iconBg: 'bg-gradient-to-br from-blue-600 to-indigo-600 text-white shadow-blue-500/30',
    cardBorderHover: 'hover:border-blue-500 hover:shadow-blue-500/20',
    cardBg: 'bg-gradient-to-br from-blue-100/70 via-indigo-50/60 to-sky-50 border-2 border-blue-300',
    footerBorder: 'border-blue-200/90',
    footerLink: 'text-blue-800 hover:text-blue-950',
    icon: 'tutoring',
  },
  {
    number: '03',
    title: 'Skills Development',
    text: 'Practical opportunities to develop commercial, administrative and entrepreneurial capabilities that prepare you for the workplace.',
    badge: 'Skills',
    badgeStyle: 'bg-emerald-200/90 text-emerald-950 border-emerald-400 font-bold',
    accentGradient: 'from-emerald-500 via-teal-500 to-emerald-600',
    iconBg: 'bg-gradient-to-br from-emerald-600 to-teal-600 text-white shadow-emerald-500/30',
    cardBorderHover: 'hover:border-emerald-500 hover:shadow-emerald-500/20',
    cardBg: 'bg-gradient-to-br from-emerald-100/70 via-teal-50/60 to-emerald-50 border-2 border-emerald-300',
    footerBorder: 'border-emerald-200/90',
    footerLink: 'text-emerald-800 hover:text-emerald-950',
    icon: 'skills',
  },
  {
    number: '04',
    title: 'University Admissions Guidance',
    text: 'Structured support in understanding UK higher education pathways, entry requirements, UCAS applications, and foundation routes.',
    badge: 'Admissions',
    badgeStyle: 'bg-purple-200/90 text-purple-950 border-purple-400 font-bold',
    accentGradient: 'from-purple-500 via-indigo-600 to-purple-600',
    iconBg: 'bg-gradient-to-br from-purple-600 to-indigo-600 text-white shadow-purple-500/30',
    cardBorderHover: 'hover:border-purple-500 hover:shadow-purple-500/20',
    cardBg: 'bg-gradient-to-br from-purple-100/70 via-fuchsia-50/60 to-indigo-50 border-2 border-purple-300',
    footerBorder: 'border-purple-200/90',
    footerLink: 'text-purple-800 hover:text-purple-950',
    icon: 'admissions',
  },
];

const pathwaySteps = [
  {
    step: '01',
    level: 'Level 2 & 3 Foundations',
    title: 'Foundation & Entry Pathways',
    description: 'Establish core business, IT, and administrative skills. Perfect for learners preparing for higher education or entering employment.',
    target: 'Age 16+ · High School graduates',
    accentBar: 'bg-gradient-to-r from-amber-400 via-amber-500 to-orange-500',
    badgeColor: 'bg-amber-200/90 text-amber-950 border-amber-400 font-bold',
    stepBadge: 'bg-gradient-to-br from-amber-500 to-orange-500 text-white shadow-amber-500/35',
    cardBg: 'bg-gradient-to-br from-amber-100/70 via-amber-50/80 to-orange-50/60',
    borderColor: 'border-2 border-amber-300 hover:border-amber-500',
    shadowColor: 'hover:shadow-amber-500/20',
    targetBg: 'bg-amber-200/60 text-amber-950 border-t-2 border-amber-200/90',
    exploreText: 'text-amber-800 hover:text-amber-950',
  },
  {
    step: '02',
    level: 'Level 4 & 5 Diplomas',
    title: 'Advanced Business & Management',
    description: 'Equivalent in academic rigor to the first two years of a UK undergraduate degree, covering leadership, strategy, and operations.',
    target: 'Undergraduate level study',
    accentBar: 'bg-gradient-to-r from-blue-500 via-indigo-600 to-blue-700',
    badgeColor: 'bg-blue-200/90 text-blue-950 border-blue-400 font-bold',
    stepBadge: 'bg-gradient-to-br from-blue-600 to-indigo-600 text-white shadow-blue-500/35',
    cardBg: 'bg-gradient-to-br from-blue-100/70 via-blue-50/80 to-indigo-50/60',
    borderColor: 'border-2 border-blue-300 hover:border-blue-500',
    shadowColor: 'hover:shadow-blue-500/20',
    targetBg: 'bg-blue-200/60 text-blue-950 border-t-2 border-blue-200/90',
    exploreText: 'text-blue-800 hover:text-blue-950',
  },
  {
    step: '03',
    level: 'Progression & Career',
    title: 'Degree Top-Up & Career Advancement',
    description: 'Use your recognised credits towards university progression, Bachelor top-up degrees, or managerial positions in the international marketplace.',
    target: 'University & Professional roles',
    accentBar: 'bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600',
    badgeColor: 'bg-emerald-200/90 text-emerald-950 border-emerald-400 font-bold',
    stepBadge: 'bg-gradient-to-br from-emerald-600 to-teal-600 text-white shadow-emerald-500/35',
    cardBg: 'bg-gradient-to-br from-emerald-100/70 via-emerald-50/80 to-teal-50/60',
    borderColor: 'border-2 border-emerald-300 hover:border-emerald-500',
    shadowColor: 'hover:shadow-emerald-500/20',
    targetBg: 'bg-emerald-200/60 text-emerald-950 border-t-2 border-emerald-200/90',
    exploreText: 'text-emerald-800 hover:text-emerald-950',
  },
];

function getCourseTheme(level: string, category: string) {
  if (category === 'International Foundation') {
    return {
      cardBg: 'bg-gradient-to-r from-emerald-100/60 via-teal-50/50 to-white',
      borderLeft: 'border-l-[6px] border-l-emerald-600 border-2 border-emerald-300',
      badgeBg: 'bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold border border-emerald-700 shadow-xs',
      creditsBg: 'bg-emerald-200/90 text-emerald-950 border border-emerald-400 font-bold',
      cardHover: 'hover:border-emerald-500 hover:shadow-lg hover:shadow-emerald-500/15',
      dotColor: 'bg-emerald-600',
      tagText: 'text-emerald-900',
      titleHover: 'hover:text-emerald-700',
      iconEmoji: '🌍',
    };
  }
  if (level.includes('Level 5')) {
    return {
      cardBg: 'bg-gradient-to-r from-purple-100/60 via-indigo-50/50 to-white',
      borderLeft: 'border-l-[6px] border-l-purple-600 border-2 border-purple-300',
      badgeBg: 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold border border-purple-700 shadow-xs',
      creditsBg: 'bg-purple-200/90 text-purple-950 border border-purple-400 font-bold',
      cardHover: 'hover:border-purple-500 hover:shadow-lg hover:shadow-purple-500/15',
      dotColor: 'bg-purple-600',
      tagText: 'text-purple-900',
      titleHover: 'hover:text-purple-700',
      iconEmoji: '🎯',
    };
  }
  if (level.includes('Level 4')) {
    return {
      cardBg: 'bg-gradient-to-r from-blue-100/60 via-indigo-50/50 to-white',
      borderLeft: 'border-l-[6px] border-l-blue-600 border-2 border-blue-300',
      badgeBg: 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold border border-blue-700 shadow-xs',
      creditsBg: 'bg-blue-200/90 text-blue-950 border border-blue-400 font-bold',
      cardHover: 'hover:border-blue-500 hover:shadow-lg hover:shadow-blue-500/15',
      dotColor: 'bg-blue-600',
      tagText: 'text-blue-900',
      titleHover: 'hover:text-blue-700',
      iconEmoji: '💼',
    };
  }
  if (level.includes('Level 3')) {
    return {
      cardBg: 'bg-gradient-to-r from-amber-100/60 via-orange-50/50 to-white',
      borderLeft: 'border-l-[6px] border-l-amber-500 border-2 border-amber-300',
      badgeBg: 'bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold border border-amber-600 shadow-xs',
      creditsBg: 'bg-amber-200/90 text-amber-950 border border-amber-400 font-bold',
      cardHover: 'hover:border-amber-500 hover:shadow-lg hover:shadow-amber-500/15',
      dotColor: 'bg-amber-600',
      tagText: 'text-amber-900',
      titleHover: 'hover:text-amber-700',
      iconEmoji: '💡',
    };
  }
  return {
    cardBg: 'bg-gradient-to-r from-slate-100/60 via-slate-50 to-white',
    borderLeft: 'border-l-[6px] border-l-slate-500 border-2 border-slate-300',
    badgeBg: 'bg-slate-700 text-white font-bold border border-slate-800 shadow-xs',
    creditsBg: 'bg-slate-200 text-slate-900 border border-slate-300 font-bold',
    cardHover: 'hover:border-slate-400 hover:shadow-lg hover:shadow-slate-500/10',
    dotColor: 'bg-slate-600',
    tagText: 'text-slate-900',
    titleHover: 'hover:text-slate-800',
    iconEmoji: '📚',
  };
}
---

<Layout
  path="/"
  title="Empowering Learners. Inspiring Futures."
  description="Infinity International Skills Development Ltd supports learners through personalised educational guidance, skills development and access to recognised Gatehouse Awards qualifications."
>
  <!-- Hero Section with Rich Ambient Colorful Glows -->
  <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-b from-blue-50/80 via-indigo-50/40 to-white">
    <!-- Ambient decorative color glows -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-gradient-to-br from-amber-400/25 via-orange-300/20 to-transparent rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-1/3 -right-28 w-[32rem] h-[32rem] bg-gradient-to-bl from-blue-400/25 via-indigo-300/20 to-emerald-300/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="container-site grid lg:grid-cols-12 gap-12 lg:gap-14 items-center py-16 lg:py-24 relative">
      <div class="lg:col-span-7">
        <!-- Trust badge with vibrant gradient styling -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-gradient-to-r from-blue-100 via-indigo-100 to-amber-100 border border-blue-200/80 text-brand-900 shadow-xs mb-6">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span class="tracking-wide">Educational Support &amp; Regulated UK Qualifications</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl leading-[1.12] text-brand-900 font-serif">
          Empowering Learners. <br />
          <span class="bg-gradient-to-r from-amber-600 via-orange-500 to-amber-700 bg-clip-text text-transparent italic font-serif">
            Inspiring Futures.
          </span>
        </h1>

        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-xl">
          At <strong class="text-slate-900 font-semibold">Infinity International Skills Development Ltd</strong>, we believe quality education should be accessible to everyone. We support learners through personalised guidance, skills development and access to information about recognised UK professional qualifications.
        </p>

        <!-- CTAs: Primary + WhatsApp + Enquiry with enhanced color & shadows -->
        <div class="mt-8 flex flex-wrap gap-3.5 items-center">
          <a
            href="/courses"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold bg-gradient-to-r from-brand-800 via-brand-700 to-blue-700 hover:from-brand-900 hover:to-blue-800 text-white shadow-md shadow-brand-900/20 hover:shadow-lg hover:-translate-y-0.5 transition-all"
          >
            <span>Explore Courses</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="https://wa.me/447515474714?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20UK%20qualifications%20and%20admissions."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white shadow-md shadow-emerald-700/20 hover:shadow-lg hover:-translate-y-0.5 transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.075-2.227-.557-1.745-.722-2.883-2.502-2.97-2.618-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.087-.179.182-.077.357.101.174.453.748.971 1.209.669.595 1.233.78 1.408.867.174.087.275.072.376-.043.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.158.572 4.184 1.574 5.938l-1.574 5.754 5.922-1.553c1.706.942 3.666 1.477 5.753 1.477 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z" />
            </svg>
            <span>WhatsApp Chat</span>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold border-2 border-slate-300 text-slate-800 bg-white hover:border-amber-400 hover:bg-amber-50/50 shadow-xs hover:-translate-y-0.5 transition-all"
          >
            <span>Make an Enquiry</span>
          </a>
        </div>
      </div>

      <!-- Hero Visual Image with Highlights and Colorful Badges -->
      <div class="lg:col-span-5 relative">
        <!-- Vibrant gradient halo frame around image -->
        <div class="p-2.5 rounded-3xl bg-gradient-to-br from-amber-400 via-blue-400 to-emerald-400 shadow-xl shadow-indigo-950/15">
          <div class="rounded-2xl overflow-hidden bg-white">
            <img
              src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=1000&q=75&auto=format&fit=crop"
              alt="Students collaborating on coursework"
              class="w-full aspect-[4/3] object-cover hover:scale-102 transition-transform duration-500"
              width="1000"
              height="750"
              fetchpriority="high"
            />
          </div>
        </div>

        <!-- Floating Badge 1: Regulated Gatehouse Awards -->
        <div class="hidden sm:flex absolute -bottom-5 -left-5 bg-gradient-to-r from-emerald-50 via-teal-50 to-white border-2 border-emerald-300 rounded-2xl p-4 shadow-xl shadow-emerald-950/15 items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex items-center justify-center font-bold text-lg shadow-md shadow-emerald-600/35">
            ✓
          </div>
          <div class="text-xs">
            <span class="block font-bold text-emerald-950 text-sm">Ofqual Regulated</span>
            <span class="text-emerald-800 font-semibold">Gatehouse Awards Qualifications</span>
          </div>
        </div>

        <!-- Floating Badge 2: London & Global Badge -->
        <div class="hidden sm:flex absolute -top-4 -right-4 bg-gradient-to-r from-amber-50 via-orange-50 to-white border-2 border-amber-300 rounded-2xl px-4 py-3 shadow-xl shadow-amber-950/15 items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 text-white flex items-center justify-center text-sm shadow-md shadow-amber-500/35">
            ⭐
          </div>
          <div class="text-xs">
            <span class="block font-bold text-amber-950">London HQ</span>
            <span class="text-amber-800 font-semibold">Global Student Support</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credibility & Fast Facts Strip in Colorful Micro-Cards -->
  <section class="border-b border-slate-200/80 bg-gradient-to-r from-blue-50/80 via-indigo-50/60 to-amber-50/70 py-8">
    <div class="container-site grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <div class="flex items-center gap-4 bg-gradient-to-br from-blue-100/80 via-blue-50/90 to-indigo-100/60 p-4.5 rounded-2xl border-2 border-blue-300 shadow-sm hover:border-blue-500 hover:shadow-md hover:-translate-y-0.5 transition-all">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white flex items-center justify-center shrink-0 shadow-md shadow-blue-600/30 text-xl">
          🎓
        </div>
        <div>
          <div class="font-bold text-base text-blue-950 leading-snug">11 Qualifications</div>
          <div class="text-xs text-blue-800 font-bold mt-0.5">Levels 2 to 5 Diplomas</div>
        </div>
      </div>

      <div class="flex items-center gap-4 bg-gradient-to-br from-amber-100/80 via-amber-50/90 to-orange-100/60 p-4.5 rounded-2xl border-2 border-amber-300 shadow-sm hover:border-amber-500 hover:shadow-md hover:-translate-y-0.5 transition-all">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 text-white flex items-center justify-center shrink-0 shadow-md shadow-amber-500/30 text-xl">
          🏛️
        </div>
        <div>
          <div class="font-bold text-base text-amber-950 leading-snug">Gatehouse Awards</div>
          <div class="text-xs text-amber-800 font-bold mt-0.5">UK Ofqual-Regulated Body</div>
        </div>
      </div>

      <div class="flex items-center gap-4 bg-gradient-to-br from-rose-100/80 via-rose-50/90 to-pink-100/60 p-4.5 rounded-2xl border-2 border-rose-300 shadow-sm hover:border-rose-500 hover:shadow-md hover:-translate-y-0.5 transition-all">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-rose-500 to-pink-600 text-white flex items-center justify-center shrink-0 shadow-md shadow-rose-500/30 text-xl">
          📍
        </div>
        <div>
          <div class="font-bold text-base text-rose-950 leading-snug">London Headquarters</div>
          <div class="text-xs text-rose-800 font-bold mt-0.5">38 Woodgrange Rd, E7 0QH</div>
        </div>
      </div>

      <div class="flex items-center gap-4 bg-gradient-to-br from-emerald-100/80 via-emerald-50/90 to-teal-100/60 p-4.5 rounded-2xl border-2 border-emerald-300 shadow-sm hover:border-emerald-500 hover:shadow-md hover:-translate-y-0.5 transition-all">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex items-center justify-center shrink-0 shadow-md shadow-emerald-500/30 text-xl">
          💬
        </div>
        <div>
          <div class="font-bold text-base text-emerald-950 leading-snug">WhatsApp Support</div>
          <div class="text-xs text-emerald-800 font-bold mt-0.5">+44 7515 474714</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Progression Pathway with Rich Colorful Journey Cards -->
  <section class="py-20 lg:py-24 bg-gradient-to-b from-white via-slate-50 to-white border-b border-slate-200">
    <div class="container-site">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-900 bg-amber-100 border-2 border-amber-300 px-4 py-1.5 rounded-full mb-3 shadow-xs">
          <span>✨</span>
          <span>Your Educational Journey</span>
        </span>
        <h2 class="text-3xl md:text-4xl text-brand-900 font-serif">
          Progression Pathway to UK Higher Education &amp; Careers
        </h2>
        <p class="mt-4 text-slate-600 text-base sm:text-lg">
          Our qualifications provide recognized credit-bearing milestones, allowing learners to advance step-by-step from foundational learning into advanced diplomas and university degrees.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        {pathwaySteps.map((s) => (
          <div class={`rounded-2xl ${s.borderColor} ${s.cardBg} shadow-md flex flex-col justify-between overflow-hidden hover:shadow-2xl ${s.shadowColor} hover:-translate-y-1.5 transition-all duration-300`}>
            <!-- Colorful Top Accent Header Bar -->
            <div class={`h-3 w-full ${s.accentBar}`}></div>

            <div class="p-8">
              <div class="flex items-center justify-between gap-2 mb-5">
                <span class={`text-xs font-bold px-3 py-1 rounded-lg border ${s.badgeColor} shadow-xs`}>
                  {s.level}
                </span>
                <span class={`w-10 h-10 rounded-full ${s.stepBadge} flex items-center justify-center font-bold text-sm shadow-md`}>
                  {s.step}
                </span>
              </div>
              <h3 class="text-xl font-bold text-brand-900 mb-3">{s.title}</h3>
              <p class="text-sm text-slate-700 leading-relaxed mb-6">{s.description}</p>
            </div>

            <div class={`px-8 py-4 ${s.targetBg} flex items-center justify-between text-xs`}>
              <span class="font-bold">{s.target}</span>
              <a href="/courses" class={`font-bold ${s.exploreText} underline-offset-4 hover:underline inline-flex items-center gap-1`}>
                <span>Explore</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center">
        <p class="text-sm text-slate-600 max-w-2xl mx-auto">
          Need personalized advice on which stage aligns with your current qualifications or HSC / A-Level results?
        </p>
        <div class="mt-5 flex justify-center flex-wrap gap-3.5">
          <a
            href="https://wa.me/447515474714?text=Hello%2C%20I%20am%20from%20Bangladesh%20and%20would%20like%20guidance%20on%20UK%20course%20progression."
            target="_blank"
            rel="noopener noreferrer"
