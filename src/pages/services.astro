---
import Layout from '../layouts/Layout.astro';
---

<Layout path="/services">
  <section class="max-w-5xl mx-auto px-4 py-20">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        Our Engineering Services
      </h1>
      <p class="text-lg text-slate-400">
        Scalable web development, automated SEO telemetry, and high-performance hosting migrations.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-700 transition-all">
        <div class="text-indigo-400 font-semibold text-sm mb-2">01 / Performance</div>
        <h3 class="text-2xl font-bold text-white mb-3">Core Web Vitals Optimization</h3>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          We audit LCP, FID/INP, and CLS bottlenecks, trimming bundle sizes and optimizing delivery pipelines to guarantee top Lighthouse scores.
        </p>
        <span class="text-xs px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-300 border border-indigo-500/20">95+ Guaranteed Score</span>
      </div>

      <div class="p-8 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-700 transition-all">
        <div class="text-purple-400 font-semibold text-sm mb-2">02 / Technical SEO</div>
        <h3 class="text-2xl font-bold text-white mb-3">Schema & Crawl Architecture</h3>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Automate dynamic sitemaps, structured JSON-LD data types, canonical link tags, and social cards directly from a centralized database.
        </p>
        <span class="text-xs px-3 py-1 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20">Rich Google Snippets</span>
      </div>
    </div>
  </section>
</Layout>

