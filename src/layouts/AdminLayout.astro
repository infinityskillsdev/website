---
import '../styles/global.css';

interface Props {
  title: string;
  activeTab: 'seo' | 'blog';
}

const { title, activeTab } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Infinity Studio</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen antialiased flex flex-col">
    <!-- Admin Top Bar -->
    <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href="/" class="flex items-center gap-2.5 text-white font-bold tracking-tight text-lg hover:text-indigo-400 transition-colors">
            <img src="/icon.png" alt="Infinity" width="320" height="320" class="h-8 w-8 rounded-lg bg-white p-0.5 object-contain" />
            <span>Infinity<span class="text-indigo-400">Admin</span></span>
          </a>

          <!-- Admin Main Tabs -->
          <nav class="flex items-center gap-2">
            <a
              href="/admin/seo"
              class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1.5 ${
                activeTab === 'seo'
                  ? 'bg-indigo-600 text-white shadow-sm'
                  : 'text-slate-400 hover:text-white hover:bg-slate-900'
              }`}
            >
              <span>🚀</span>
              <span>SEO Panel</span>
            </a>
            <a
              href="/admin/blog"
              class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1.5 ${
                activeTab === 'blog'
                  ? 'bg-indigo-600 text-white shadow-sm'
                  : 'text-slate-400 hover:text-white hover:bg-slate-900'
              }`}
            >
              <span>✍️</span>
              <span>Blog Manager</span>
            </a>
          </nav>
        </div>

        <div class="flex items-center gap-4">
          <a
            href="/"
            target="_blank"
            class="text-xs font-medium text-slate-400 hover:text-white flex items-center gap-1 transition-colors"
          >
            <span>Live Site</span>
            <span>↗</span>
          </a>

          <button
            id="logoutBtn"
            class="text-xs font-semibold text-rose-400 hover:text-rose-300 px-3 py-1.5 rounded-lg border border-rose-500/20 bg-rose-500/10 hover:bg-rose-500/20 transition-all cursor-pointer"
          >
            Logout
          </button>
        </div>
      </div>
    </header>

    <!-- Main Dashboard Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">
      <slot />
    </main>

    <script>
      const logoutBtn = document.getElementById('logoutBtn');
      logoutBtn?.addEventListener('click', async () => {
        if (!confirm('Log out of admin panel?')) return;
        try {
          await fetch('/api/admin/auth', { method: 'DELETE' });
          window.location.href = '/admin/login';
        } catch (e) {
          console.error(e);
        }
      });
    </script>
  </body>
</html>
